{
  "compilerOptions": {
    "target": "ES2020",
    "types": ["node"],
    "module": "commonjs",
    "strict": true,
    "noImplicitAny": true,
    "paths": {
      "@pom/*": ["./src/pom/*"],
      "@fixtures/*": ["./src/fixtures/*"],
      "@utils/*": ["./src/utils/*"],
      "@data/*": ["./src/data/*"]
    }
  }
}
